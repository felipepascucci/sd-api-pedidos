# Arquivo OPCIONAL, apenas de referência.
# O docker-compose.yml já define valores padrão para todas as variáveis abaixo,
# então `docker compose up -d --build` funciona sem nenhum arquivo .env.
# Para personalizar, copie este arquivo para `.env` e altere os valores.
POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
